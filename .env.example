# Add only the provider keys you use. Never commit .env.
# Best Russian defaults: Yandex SpeechKit or an ElevenLabs native Russian voice.
YANDEX_API_KEY=
ELEVENLABS_API_KEY=
# Pick a Russian-speaking voice in your ElevenLabs account (voice ID, not voice name).
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Official Microsoft voice used in the user's preferred audition.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional offline Qwen3 VoiceDesign, set up separately (Apple Silicon / Python 3.12).
# SHORTS_LOCAL_TTS_PYTHON=/absolute/path/to/shorts/.venv-voice/bin/python
SHORTS_LOCAL_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-4bit

# Scripts, images and optional legacy OpenAI voice.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional read-only YouTube Data API v3 research; no private Studio metrics.
YOUTUBE_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# NOTE: gpt-4o-mini-tts Speech API is deprecated; provider announced shutdown January 6, 2027.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

# Optional custom Cyrillic font for the video overlay.
# SHORTS_FONT=/absolute/path/to/a/cyrillic.ttf
